<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:lrmi="http://purl.org/dcx/lrmi-terms/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:schema="http://schema.org/">
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_0">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 1.1 Identifikation | Bloom's: 2 Verstehen | Data Flow: 1 Planung</schema:targetDescription>
    <schema:targetName>Forschungsdaten können definiert und film- und medienwissenschaftliche Daten als Primär- oder Sekundärdaten eingeordnet werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_1">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 1.2 Qualitätssicherung | Bloom's: 5 Bewerten | Data Flow: 1 Planung</schema:targetDescription>
    <schema:targetName>Die Entstehung, Auswahl und Kategorisierung von Forschungsdaten kann kritisch reflektiert und die Annahme einer neutralen Datengrundlage hinterfragt werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_2">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 2.1 Erhebung | Bloom's: 3 Anwenden | Data Flow: 2 Erhebung und Aufbereitung</schema:targetDescription>
    <schema:targetName>Für eigene Fragestellungen können gängige Methoden der Datenerhebung ausgewählt und Arten der Nachnutzung unterschieden werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_3">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.1 Organisation | Bloom's: 5 Bewerten | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Zentrale Standards und Planungsinstrumente des Forschungsdatenmanagements können evaluiert und ihre Bedeutung für den Umgang mit filmwissenschaftlichen Forschungsdaten beurteilt werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1_objective_0">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.2 Erschließung | Bloom's: 5 Bewerten | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Arten und Funktionen von Metadaten können erläutert und anhand eines Fragenkatalogs geeignete generische Metadatenstandards für ein eigenes Projekt begründet werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1_objective_1">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.2 Erschließung | Bloom's: 5 Bewerten | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Fachspezifische Metadatenstandards der Filmwissenschaft können unterschieden und ihre Eignung für unterschiedliche Forschungsgegenstände und Projektszenarien abgewogen werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1_objective_2">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.2 Erschließung | Bloom's: 3 Anwenden | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Diskriminierende Metadaten können identifiziert und geeignete diskriminierungssensible Praktiken auf den eigenen Umgang mit sensiblen Daten übertragen werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_2_objective_0">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 5.2 Datenpublikation | Bloom's: 2 Verstehen | Data Flow: 5 Publikation und Nachnutzung</schema:targetDescription>
    <schema:targetName>Der Begriff der Datenpublikation kann erläutert und Leitfragen zur Wahl eines Publikationswegs benannt werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_2_objective_1">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 5.2 Datenpublikation | Bloom's: 3 Anwenden | Data Flow: 5 Publikation und Nachnutzung</schema:targetDescription>
    <schema:targetName>Für unterschiedliche Datenszenarien können Publikationswege verglichen und ein geeigneter Publikationsweg ausgewählt werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_0">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 4.2 Visualisierung | Bloom's: 3 Anwenden | Data Flow: 4 Analyse</schema:targetDescription>
    <schema:targetName>Moviebarcodes können aus audiovisuellen Daten erzeugt und ihre Bedeutung für die Analyse und Anreicherung filmwissenschaftlicher Forschungsdaten erläutert werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_1">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Der Aufbau eines projektspezifischen Metadatenschemas kann erläutert und dessen Mapping auf etablierte Metadatenstandards nachvollzogen werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_2">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 2.3 Aufbereitung | Bloom's: 3 Anwenden | Data Flow: 2 Erhebung und Aufbereitung</schema:targetDescription>
    <schema:targetName>Metadaten können in offene, nicht-proprietäre Formate konvertiert und der Datensatz für die Nachnutzung dokumentiert werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_3">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 2.2 Validierung | Bloom's: 3 Anwenden | Data Flow: 2 Erhebung und Aufbereitung</schema:targetDescription>
    <schema:targetName>Es können Verfahren zur automatisierten Validierung von Metadaten angewendet, Fehler und Inkonsistenzen erkannt und der Datensatz bereinigt werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_4">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 1.2 Qualitätssicherung | Bloom's: 5 Bewerten | Data Flow: 1 Planung</schema:targetDescription>
    <schema:targetName>Eine diskriminierungssensible Überprüfung kann anhand ausgewählter Metadaten durchgeführt und die Ergebnisse kritisch reflektiert werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4_objective_0">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.1 Organisation | Bloom's: 5 Bewerten | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Ein Versionierungsschema sowie eine geeignete Lizenz für heterogene Forschungsdaten können ausgewählt und die Zitierfähigkeit des Datensatzes sichergestellt werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4_objective_1">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 3.1 Organisation | Bloom's: 3 Anwenden | Data Flow: 3 Management</schema:targetDescription>
    <schema:targetName>Anhand etablierter Best Practices kann ein Datenset publikationsgerecht organisiert und verwaltet werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:AlignmentObject rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4_objective_2">
    <schema:educationalFramework>QUADRIGA Competency Framework</schema:educationalFramework>
    <schema:targetDescription>Competency: 5.2 Datenpublikation | Bloom's: 3 Anwenden | Data Flow: 5 Publikation und Nachnutzung</schema:targetDescription>
    <schema:targetName>Ein Repository kann angelegt, mit Forschungsdaten befüllt und als versionierter, zitierfähiger Release mit DOI veröffentlicht werden.</schema:targetName>
  </schema:AlignmentObject>
  <schema:Book rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3">
    <dc:type>Jupyter Book</dc:type>
    <dcterms:tableOfContents>- Einstieg
- Forschungsdaten und Datenmanagement in der Filmwissenschaft
- Metadaten und Metadatenstandards
- Datenpublikation in der Filmwissenschaft
- Aufbereitung und Anreicherung filmwissenschaftlicher Daten
- Publikation von Datensets in einem Repositorium
- Reflexion und Resümee
- Abschluss</dcterms:tableOfContents>
