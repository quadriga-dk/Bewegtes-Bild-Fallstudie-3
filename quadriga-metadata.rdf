    <schema:dateModified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</schema:dateModified>
    <schema:datePublished rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-04</schema:datePublished>
    <schema:description>Interaktives Lehrbuch zur praxisnahen Aufbereitung, Anreicherung und Publikation filmwissenschaftlicher Forschungsdaten auf Repositorien anhand eines konkreten Forschungsprojekts.</schema:description>
    <schema:funding>Die vorliegenden Open Educational Resources wurden durch das Datenkompetenzzentrum QUADRIGA erstellt.

Förderkennzeichen: 16DKZ2034</schema:funding>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0">
        <schema:description>Einführung in Forschungsdaten und Forschungsdatenmanagement (FDM) mit Fokus auf die Film- und Medienwissenschaft, inklusive FAIR-Prinzipien, DFG-Leitlinien und Datenmanagementplan.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_0" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_1" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_2" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_0_objective_3" />
        <schema:name>Forschungsdaten und Datenmanagement in der Filmwissenschaft</schema:name>
        <schema:teaches>Anwendung zentraler Prinzipien und Methoden des Forschungsdatenmanagements auf film- und medienwissenschaftliche Forschungsdaten</schema:teaches>
        <schema:timeRequired>PT1H30M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/02_forschungsdaten_fdm/toc_02.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1">
        <schema:description>Einführung in Metadaten und gängige Metadatenstandards (u. a. Dublin Core, DataCite, EN 15744/15907) mit besonderem Blick auf diskriminierungssensible Metadatenpraxis in der Filmwissenschaft.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1_objective_0" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1_objective_1" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_1_objective_2" />
        <schema:name>Metadaten und Metadatenstandards</schema:name>
        <schema:teaches>Einordnung und Auswahl von Metadatenstandards für filmwissenschaftliche Forschungsdaten unter Berücksichtigung diskriminierungssensibler Perspektiven</schema:teaches>
        <schema:timeRequired>PT1H</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/03_metadaten/toc_03.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_2">
        <schema:description>Strategien, Publikationswege und -formate (Repositorien, Data Paper, APIs u. a.) zur Veröffentlichung filmwissenschaftlicher Forschungsdaten sowie rechtliche Entscheidungshilfen.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_2_objective_0" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_2_objective_1" />
        <schema:name>Datenpublikation in der Filmwissenschaft</schema:name>
        <schema:teaches>Perspektiven, Strategien und Wege zur Publikation filmwissenschaftlicher Forschungsdaten</schema:teaches>
        <schema:timeRequired>PT40M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/04_einführung_publikation/toc_04.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3">
        <schema:description>Praxisnahe Aufbereitung, Formatierung, Bereinigung und Anreicherung (u. a. mit Moviebarcodes) eines filmwissenschaftlichen Forschungsdatensets anhand eines konkreten Fallbeispiels.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_0" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_1" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_2" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_3" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_3_objective_4" />
        <schema:name>Aufbereitung und Anreicherung filmwissenschaftlicher Daten</schema:name>
        <schema:teaches>Publikationsgerechte Aufbereitung, Bereinigung und Anreicherung filmwissenschaftlicher Forschungsdaten</schema:teaches>
        <schema:timeRequired>PT1H30M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/05_aufbereitung_anreicherung/toc_05.html" />
      </schema:LearningResource>
    </schema:hasPart>
    <schema:hasPart>
      <schema:LearningResource rdf:about="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4">
        <schema:description>Schritt-für-Schritt-Anleitung zur Publikation eines Forschungsdatensets auf GitHub und Zenodo, inklusive Versionierung, Lizenzierung, Zitierfähigkeit und Datenkuratierung.</schema:description>
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4_objective_0" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4_objective_1" />
        <schema:educationalAlignment rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3#chapter_4_objective_2" />
        <schema:name>Publikation von Datensets in einem Repositorium</schema:name>
        <schema:teaches>Nachhaltige Publikation filmwissenschaftlicher Forschungsdaten in Repositorien unter Berücksichtigung zentraler Anforderungen des Forschungsdatenmanagements</schema:teaches>
        <schema:timeRequired>PT1H30M</schema:timeRequired>
        <schema:url rdf:resource="https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/06_publikation_repositorien/toc_06.html" />
      </schema:LearningResource>
    </schema:hasPart>
