  "hasPart": [
    {
      "@type": "LearningResource",
      "name": "Forschungsdaten und Datenmanagement in der Filmwissenschaft",
      "description": "Einführung in Forschungsdaten und Forschungsdatenmanagement (FDM) mit Fokus auf die Film- und Medienwissenschaft, inklusive FAIR-Prinzipien, DFG-Leitlinien und Datenmanagementplan.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/02_forschungsdaten_fdm/toc_02.html",
      "timeRequired": "PT1H30M",
      "teaches": "Anwendung zentraler Prinzipien und Methoden des Forschungsdatenmanagements auf film- und medienwissenschaftliche Forschungsdaten",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Forschungsdaten können definiert und film- und medienwissenschaftliche Daten als Primär- oder Sekundärdaten eingeordnet werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 1.1 Identifikation | Bloom's: 2 Verstehen | Data Flow: 1 Planung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Die Entstehung, Auswahl und Kategorisierung von Forschungsdaten kann kritisch reflektiert und die Annahme einer neutralen Datengrundlage hinterfragt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 1.2 Qualitätssicherung | Bloom's: 5 Bewerten | Data Flow: 1 Planung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Für eigene Fragestellungen können gängige Methoden der Datenerhebung ausgewählt und Arten der Nachnutzung unterschieden werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 2.1 Erhebung | Bloom's: 3 Anwenden | Data Flow: 2 Erhebung und Aufbereitung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Zentrale Standards und Planungsinstrumente des Forschungsdatenmanagements können evaluiert und ihre Bedeutung für den Umgang mit filmwissenschaftlichen Forschungsdaten beurteilt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.1 Organisation | Bloom's: 5 Bewerten | Data Flow: 3 Management"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Metadaten und Metadatenstandards",
      "description": "Einführung in Metadaten und gängige Metadatenstandards (u. a. Dublin Core, DataCite, EN 15744/15907) mit besonderem Blick auf diskriminierungssensible Metadatenpraxis in der Filmwissenschaft.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/03_metadaten/toc_03.html",
      "timeRequired": "PT1H",
      "teaches": "Einordnung und Auswahl von Metadatenstandards für filmwissenschaftliche Forschungsdaten unter Berücksichtigung diskriminierungssensibler Perspektiven",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Arten und Funktionen von Metadaten können erläutert und anhand eines Fragenkatalogs geeignete generische Metadatenstandards für ein eigenes Projekt begründet werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 5 Bewerten | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Fachspezifische Metadatenstandards der Filmwissenschaft können unterschieden und ihre Eignung für unterschiedliche Forschungsgegenstände und Projektszenarien abgewogen werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 5 Bewerten | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Diskriminierende Metadaten können identifiziert und geeignete diskriminierungssensible Praktiken auf den eigenen Umgang mit sensiblen Daten übertragen werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 3 Anwenden | Data Flow: 3 Management"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Datenpublikation in der Filmwissenschaft",
      "description": "Strategien, Publikationswege und -formate (Repositorien, Data Paper, APIs u. a.) zur Veröffentlichung filmwissenschaftlicher Forschungsdaten sowie rechtliche Entscheidungshilfen.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/04_einführung_publikation/toc_04.html",
      "timeRequired": "PT40M",
      "teaches": "Perspektiven, Strategien und Wege zur Publikation filmwissenschaftlicher Forschungsdaten",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Der Begriff der Datenpublikation kann erläutert und Leitfragen zur Wahl eines Publikationswegs benannt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 5.2 Datenpublikation | Bloom's: 2 Verstehen | Data Flow: 5 Publikation und Nachnutzung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Für unterschiedliche Datenszenarien können Publikationswege verglichen und ein geeigneter Publikationsweg ausgewählt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 5.2 Datenpublikation | Bloom's: 3 Anwenden | Data Flow: 5 Publikation und Nachnutzung"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Aufbereitung und Anreicherung filmwissenschaftlicher Daten",
      "description": "Praxisnahe Aufbereitung, Formatierung, Bereinigung und Anreicherung (u. a. mit Moviebarcodes) eines filmwissenschaftlichen Forschungsdatensets anhand eines konkreten Fallbeispiels.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/05_aufbereitung_anreicherung/toc_05.html",
      "timeRequired": "PT1H30M",
      "teaches": "Publikationsgerechte Aufbereitung, Bereinigung und Anreicherung filmwissenschaftlicher Forschungsdaten",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Moviebarcodes können aus audiovisuellen Daten erzeugt und ihre Bedeutung für die Analyse und Anreicherung filmwissenschaftlicher Forschungsdaten erläutert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 4.2 Visualisierung | Bloom's: 3 Anwenden | Data Flow: 4 Analyse"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Der Aufbau eines projektspezifischen Metadatenschemas kann erläutert und dessen Mapping auf etablierte Metadatenstandards nachvollzogen werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.2 Erschließung | Bloom's: 2 Verstehen | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Metadaten können in offene, nicht-proprietäre Formate konvertiert und der Datensatz für die Nachnutzung dokumentiert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 2.3 Aufbereitung | Bloom's: 3 Anwenden | Data Flow: 2 Erhebung und Aufbereitung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Es können Verfahren zur automatisierten Validierung von Metadaten angewendet, Fehler und Inkonsistenzen erkannt und der Datensatz bereinigt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 2.2 Validierung | Bloom's: 3 Anwenden | Data Flow: 2 Erhebung und Aufbereitung"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Eine diskriminierungssensible Überprüfung kann anhand ausgewählter Metadaten durchgeführt und die Ergebnisse kritisch reflektiert werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 1.2 Qualitätssicherung | Bloom's: 5 Bewerten | Data Flow: 1 Planung"
        }
      ]
    },
    {
      "@type": "LearningResource",
      "name": "Publikation von Datensets in einem Repositorium",
      "description": "Schritt-für-Schritt-Anleitung zur Publikation eines Forschungsdatensets auf GitHub und Zenodo, inklusive Versionierung, Lizenzierung, Zitierfähigkeit und Datenkuratierung.",
      "url": "https://quadriga-dk.github.io/Bewegtes-Bild-Fallstudie-3/06_publikation_repositorien/toc_06.html",
      "timeRequired": "PT1H30M",
      "teaches": "Nachhaltige Publikation filmwissenschaftlicher Forschungsdaten in Repositorien unter Berücksichtigung zentraler Anforderungen des Forschungsdatenmanagements",
      "educationalAlignment": [
        {
          "@type": "AlignmentObject",
          "targetName": "Ein Versionierungsschema sowie eine geeignete Lizenz für heterogene Forschungsdaten können ausgewählt und die Zitierfähigkeit des Datensatzes sichergestellt werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.1 Organisation | Bloom's: 5 Bewerten | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Anhand etablierter Best Practices kann ein Datenset publikationsgerecht organisiert und verwaltet werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 3.1 Organisation | Bloom's: 3 Anwenden | Data Flow: 3 Management"
        },
        {
          "@type": "AlignmentObject",
          "targetName": "Ein Repository kann angelegt, mit Forschungsdaten befüllt und als versionierter, zitierfähiger Release mit DOI veröffentlicht werden.",
          "educationalFramework": "QUADRIGA Competency Framework",
          "targetDescription": "Competency: 5.2 Datenpublikation | Bloom's: 3 Anwenden | Data Flow: 5 Publikation und Nachnutzung"
        }
      ]
    }
  ],
  "dcterms:tableOfContents": "- Einstieg\n- Forschungsdaten und Datenmanagement in der Filmwissenschaft\n- Metadaten und Metadatenstandards\n- Datenpublikation in der Filmwissenschaft\n- Aufbereitung und Anreicherung filmwissenschaftlicher Daten\n- Publikation von Datensets in einem Repositorium\n- Reflexion und Resümee\n- Abschluss",
